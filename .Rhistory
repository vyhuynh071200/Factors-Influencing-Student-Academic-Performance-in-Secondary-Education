anova_failures <- aov(G3 ~ factor(failures), data = df_clean)
summary(anova_failures)
anova_failures <- aov(G3 ~ factor(failures), data = df_clean)
anova_tbl <- tidy(anova_failures)
anova_tbl$term <- c("Failures", "Residuals")
anova_tbl$statistic <- round(anova_tbl$statistic, 2)
anova_tbl$estimate <- round(anova_tbl$estimate, 2)
anova_failures <- aov(G3 ~ factor(failures), data = df_clean)
anova_tbl <- tidy(anova_failures)
anova_tbl$term <- c("Failures", "Residuals")
anova_tbl$sumsq <- round(anova_tbl$sumsq, 2)
anova_tbl$meansq <- round(anova_tbl$meansq, 2)
anova_tbl$statistic <- round(anova_tbl$statistic, 2)
colnames(anova_tbl) <- c("Source", "Df", "Sum Sq", "Mean Sq", "F value", "p-value")
kable(
anova_tbl,
caption = "One-way ANOVA results for final grade (G3) across levels of past failures",
align = "c"
)
TukeyHSD(anova_failures)
tukey_failures <- TukeyHSD(anova_failures)
tukey_tbl <- tidy(tukey_failures)
tukey_tbl$contrast <- gsub("factor\\(failures\\)", "", tukey_tbl$contrast)
tukey_tbl$estimate <- round(tukey_tbl$estimate, 2)
tukey_tbl$conf.low <- round(tukey_tbl$conf.low, 2)
tukey_tbl$conf.high <- round(tukey_tbl$conf.high, 2)
tukey_tbl$adj.p.value <- signif(tukey_tbl$adj.p.value, 3)
colnames(tukey_tbl) <- c("Comparison", "Difference", "CI Lower",
"CI Upper", "Adjusted p-value")
kable(
tukey_tbl,
caption = "Tukey HSD post-hoc comparisons for
mean final grade (G3) across levels of past failures",
align = "c"
)
tukey_failures <- TukeyHSD(anova_failures)
tukey_failures
tukey_failures <- TukeyHSD(anova_failures)
tukey_tbl <- tidy(tukey_failures)
tukey_tbl$estimate <- round(tukey_tbl$estimate, 2)
tukey_tbl$conf.low <- round(tukey_tbl$conf.low, 2)
tukey_tbl$conf.high <- round(tukey_tbl$conf.high, 2)
tukey_tbl$adj.p.value <- signif(tukey_tbl$adj.p.value, 3)
tukey_tbl <- tukey_tbl[, c("contrast", "estimate", "conf.low", "conf.high", "adj.p.value")]
colnames(tukey_tbl) <- c(
"Comparison",
"Difference",
"CI Lower",
"CI Upper",
"Adjusted p-value"
)
kable(
tukey_tbl,
caption = "Tukey HSD post-hoc comparisons for mean final grade (G3)",
align = "c"
)
