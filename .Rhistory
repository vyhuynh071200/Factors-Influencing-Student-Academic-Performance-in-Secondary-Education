install.packages("ggfortify")
#par(mfrow = c(2, 2))
#plot(model_failures)
library(ggfortify)
autoplot(model_failures)
library(ggplot2)
plot_data <- data.frame(
fitted = fitted(model_failures),
resid  = resid(model_failures)
)
ggplot(plot_data, aes(x = fitted, y = resid)) +
geom_point(color = "black", size = 2) +
geom_smooth(se = FALSE, color = "#2C7FB8", linewidth = 1.2) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
labs(
title = "Residuals vs Fitted",
x = "Fitted Values (Group Means)",
y = "Residuals"
) +
theme_minimal(base_size = 12)
diag_df <- data.frame(
fitted    = fitted(model_failures),
residuals = residuals(model_failures),
std_resid = rstandard(model_failures)
)
ggplot(diag_df, aes(x = fitted, y = residuals)) +
geom_point(alpha = 0.3) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_smooth(method = "lm", se = FALSE, color = "steelblue", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Residuals vs Fitted",
x = "Fitted Values (Group Means)",
y = "Residuals"
)
ggplot(diag_df, aes(sample = std_resid)) +
stat_qq(alpha = 0.3) +
stat_qq_line(color = "red", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Q-Q Residuals",
x = "Theoretical Quantiles",
y = "Standardized Residuals"
)
ggplot(diag_failures, aes(sample = std_resid)) +
stat_qq(alpha = 0.3) +
stat_qq_line(color = "red", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Q-Q Residuals",
x = "Theoretical Quantiles",
y = "Standardized Residuals"
)
diag_failures <- data.frame(
fitted    = fitted(model_failures),
residuals = residuals(model_failures),
std_resid = rstandard(model_failures)
)
ggplot(diag_failures, aes(x = fitted, y = residuals)) +
geom_point(alpha = 0.3) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_smooth(method = "lm", se = FALSE, color = "steelblue", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Residuals vs Fitted",
x = "Fitted Values (Group Means)",
y = "Residuals"
)
ggplot(diag_failures, aes(sample = std_resid)) +
stat_qq(alpha = 0.3) +
stat_qq_line(color = "red", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Q-Q Residuals",
x = "Theoretical Quantiles",
y = "Standardized Residuals"
)
ggplot(diag_failures, aes(x = fitted, y = sqrt(abs(std_resid)))) +
geom_point(alpha = 0.3) +
geom_smooth(method = "lm", se = FALSE, color = "steelblue", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Scale-Location",
x = "Fitted Values (Group Means)",
y = expression(sqrt("|Standardized residuals|"))
)
diag_failures$leverage <- hatvalues(model_failures)
ggplot(diag_failures, aes(x = leverage, y = std_resid)) +
geom_point(alpha = 0.3) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_smooth(method = "lm", se = FALSE, color = "steelblue", linewidth = 0.8) +
theme_minimal() +
labs(
title = "Residuals vs Leverage",
x = "Leverage",
y = "Standardized Residuals"
)
