# Fit model
model_failures <- lm(G3 ~ failures, data = df_clean)
# Summary + extract
s <- summary(model_failures)
coef_s <- s$coefficients
ci <- confint(model_failures)
# Table
coef_table_failures <- data.frame(
Term = c("Intercept", "failures"),
Estimate = round(coef_s[, "Estimate"], 3),
`Std. Error` = round(coef_s[, "Std. Error"], 3),
`t value` = round(coef_s[, "t value"], 3),
`p-value` = round(coef_s[, "Pr(>|t|)"], 4),
`CI 2.5%` = round(ci[, 1], 3),
`CI 97.5%` = round(ci[, 2], 3),
check.names = FALSE
)
kable(
coef_table_failures,
caption = "Regression coefficients for the model predicting G3 from failures",
row.names = FALSE
)
# Equation
b <- round(coef(model_failures), 3)
cat("G3 =", b[1], ifelse(b[2] < 0, "-", "+"), abs(b[2]), "* failures\n")
# Simple linear regression: G3 ~ failures
model_failures <- lm(G3 ~ failures, data = df_clean)
# Summary objects
s_fail <- summary(model_failures)
coef_fail <- s_fail$coefficients
ci_fail <- confint(model_failures)
# Coefficient table
library(knitr)
coef_table_failures <- data.frame(
Term = rownames(coef_fail),
Estimate = round(coef_fail[, "Estimate"], 3),
`Std. Error` = round(coef_fail[, "Std. Error"], 3),
`t value` = round(coef_fail[, "t value"], 3),
`p-value` = round(coef_fail[, "Pr(>|t|)"], 4),
`CI 2.5%` = round(ci_fail[, 1], 3),
`CI 97.5%` = round(ci_fail[, 2], 3),
check.names = FALSE
)
kable(
coef_table_failures,
caption = "Regression coefficients for the model predicting final grade (G3) from past failures",
row.names = FALSE
)
# Extract key values for inline reporting
b0_fail <- round(coef_fail["(Intercept)", "Estimate"], 3)
b1_fail <- round(coef_fail["failures", "Estimate"], 3)
se_b1_fail <- round(coef_fail["failures", "Std. Error"], 3)
t_b1_fail <- round(coef_fail["failures", "t value"], 3)
p_b1_fail <- coef_fail["failures", "Pr(>|t|)"]
r2_fail <- round(s_fail$r.squared, 3)
adj_r2_fail <- round(s_fail$adj.r.squared, 3)
fstat_fail <- s_fail$fstatistic
f_val_fail <- round(fstat_fail["value"], 1)
f_df1_fail <- fstat_fail["numdf"]
f_df2_fail <- fstat_fail["dendf"]
f_p_fail <- pf(fstat_fail["value"], fstat_fail["numdf"], fstat_fail["dendf"], lower.tail = FALSE)
# Show equation
cat("Estimated model: G3 =", b0_fail, ifelse(b1_fail < 0, "-", "+"), abs(b1_fail), "* failures\n")
cat("Slope t-test:\n")
cat("t =", t_b1_fail, "\n")
cat("p-value =", signif(p_b1_fail, 4), "\n\n")
cat("Overall model F-test:\n")
cat("F(", f_df1_fail, ", ", f_df2_fail, ") = ", f_val_fail, "\n", sep = "")
cat("p-value =", signif(f_p_fail, 4), "\n\n")
cat("R-squared =", r2_fail, "\n")
cat("Adjusted R-squared =", adj_r2_fail, "\n")
summary(model_failures)$r.squared
model_stats_fail <- glance(model_failures)
library(knitr)
library(dplyr)
